# S-li .gitignore - Security-First and Clean Repository Rule

# ===============================
# 1. 機敏資料與認證金鑰 (Security Credentials)
# ===============================
*.env
*.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519
*.secret
*.token
credentials.json
secrets/

# ===============================
# 2. Windows 系統與使用者隱私紀錄
# ===============================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
PSReadLine/
*ConsoleHost_history.txt
history.txt

# ===============================
# 3. Python 虛擬環境與快取
# ===============================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage

# ===============================
# 4. 編輯器與 IDE 設定檔
# ===============================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ===============================
# 5. S-li 本機自訂設定暫存 (Local User Overrides)
# ===============================
core/config.local.json
*.local.ps1
*.local.sh
